*/
import Layout from '../../layouts/Layout.astro';
import IronManExperience from '../../components/IronManExperience.astro';
import { defaultLang, useTranslations } from '../../i18n/ui';

const lang = Astro.currentLocale ?? defaultLang;
const t = useTranslations(lang);
---

<Layout title={t('ironman.title')} description={t('ironman.intro')}>
	<IronManExperience
		labels={{
			statusLoading: t('ironman.status.loading'),
			statusTracking: t('ironman.status.tracking'),
			statusNoPose: t('ironman.status.noPose'),
			statusCameraDenied: t('ironman.status.cameraDenied'),
			statusLowFps: t('ironman.status.lowFps'),
			hintStart: t('ironman.hint.start'),
			hintCamera: t('ironman.hint.camera'),
			fpsLabel: t('ironman.fps'),
			infoTitle: t('ironman.info'),
		}}
	/>
</Layout>

