---
// 文件说明：在线简历页（英文，路由 /en/resume）。与中文页共用 ResumePage 组件，仅语言切换到英文数据。
import ResumePage from '../../components/resume/ResumePage.astro';
import { getResume } from '../../data/resume';
import { defaultLang } from '../../i18n/ui';
import ResumeLayout from '../../layouts/ResumeLayout.astro';

const lang = Astro.currentLocale ?? defaultLang;
const resume = getResume(lang);
---

<ResumeLayout title={resume.meta.title} description={resume.meta.description}>
	<ResumePage resume={resume} />
</ResumeLayout>
