---
// 文件说明：联系方式小图标（邮箱 / 手机 / 城市），纯内联 SVG，不引入图标库。
interface Props {
	icon: 'mail' | 'phone' | 'pin';
}
const { icon } = Astro.props;
---

<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
	{
		icon === 'mail' && (
			<>
				<rect x="3" y="5" width="18" height="14" rx="2" />
				<path d="m3.5 7 8.5 6 8.5-6" stroke-linecap="round" stroke-linejoin="round" />
			</>
		)
	}
	{
		icon === 'phone' && (
			<path
				d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5L16 12l4 1.5v3a2 2 0 0 1-2.2 2A16 16 0 0 1 4 6.2 2 2 0 0 1 6 4z"
				stroke-linecap="round"
				stroke-linejoin="round"
			/>
		)
	}
	{
		icon === 'pin' && (
			<>
				<path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11z" stroke-linejoin="round" />
				<circle cx="12" cy="10" r="2.5" />
			</>
		)
	}
</svg>
