---
// 文件说明：项目卡片网格——只展示结论性信息，点击后由 ProjectDrawer 展开完整故事。
import type { Resume } from '../../data/resume';

interface Props {
	resume: Resume;
}

const { resume } = Astro.props;
const ui = resume.ui;
---

<section class="rz-section" id="projects">
	<div class="rz-shell">
		<div class="rz-reveal">
			<div class="rz-section-head">
				<span class="rz-section-num">03</span>
				<h2 class="rz-section-title">{ui.sections.projects}</h2>
				<span class="rz-section-sub">Case Studies · {resume.projects.length}</span>
			</div>
		</div>

		<div class="rz-projects">
			{
				resume.projects.map((project, index) => (
					<button
						type="button"
						class="rz-card rz-reveal"
						data-project-id={project.id}
						style={`--rz-delay: ${(index % 2) * 70}ms`}
						aria-label={`${project.name} — ${ui.drawer.open}`}
					>
						<span class="rz-card-top">
							<span class="rz-card-index">{String(index + 1).padStart(2, '0')}</span>
							<span>{project.period}</span>
						</span>
						<h3 class="rz-card-name">{project.name}</h3>
						<p class="rz-card-sub">{project.subtitle}</p>
						<p class="rz-card-tagline">{project.tagline}</p>
						<ul class="rz-card-stack">
							{project.stack.slice(0, 4).map((tech) => (
								<li>{tech}</li>
							))}
						</ul>
						<span class="rz-card-foot">
							<span class="rz-card-role">{project.company}</span>
							<span class="rz-card-more">
								{ui.drawer.open}
								<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
									<path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</span>
						</span>
					</button>
				))
			}
		</div>
	</div>
</section>
