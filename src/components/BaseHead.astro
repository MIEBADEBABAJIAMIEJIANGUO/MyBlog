---
// 文件说明：全局头部元数据组件，包含编码、视口、图标、SEO、Open Graph 与 Twitter 卡片等标签。
// 原代码注释：占位图导入（占位图资源已删除）
// import FallbackImage from '../assets/blog-placeholder-1.jpg';
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
// 原代码注释：站点标题常量导入（RSS 链接已移除）
// import { SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}

// 生成当前页面的规范 URL
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image } = Astro.props;
---

<!-- 全局元数据 -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<!-- 原代码注释：站点地图链接（sitemap 集成已移除）
<link rel="sitemap" href="/sitemap-index.xml" />
-->
<!-- 原代码注释：RSS 订阅链接（rss 功能已移除）
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
-->
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-atkinson" preload />

<!-- DotLottie WASM + loading 动画文件预加载，尽量首屏直接出 Lottie -->
<link rel="preconnect" href="https://cdn.jsdelivr.net" />
<link
	rel="preload"
	as="fetch"
	crossorigin
	href="https://cdn.jsdelivr.net/npm/@lottiefiles/dotlottie-web@0.80.0/dist/dotlottie-player.wasm"
/>
<link rel="preload" href="/lottie/kxjHNKPm4L.lottie" as="fetch" crossorigin />

<!-- 规范链接 -->
<link rel="canonical" href={canonicalURL} />

<!-- 主要元数据 -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{image && <meta property="og:image" content={new URL(image.src, Astro.url)} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />