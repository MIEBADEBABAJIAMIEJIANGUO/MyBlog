# 文件说明：服务器端环境变量模板（无域名 / IP 访问版）。
# 用法：复制为 /opt/myblog/.env，填好密码与 IP，然后 chmod 600 /opt/myblog/.env
# 该文件绝不提交到仓库（.env 已在 .gitignore 中）。

# ---------- 数据库 ----------
MONGODB_URI=mongodb://127.0.0.1:27017/eccentric-event?directConnection=true&serverSelectionTimeoutMS=5000

# ---------- MinIO（同时作为容器 root 账号，务必改掉默认值）----------
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=CHANGE_ME_minio_user
MINIO_SECRET_KEY=CHANGE_ME_minio_password_at_least_8_chars
MINIO_BUCKET=uploads

# 前端访问文件的地址，走 nginx 的 /files/ 反代
PUBLIC_FILE_BASE_URL=http://YOUR_SERVER_IP/files

# ---------- Agent / LLM ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
TAVILY_API_KEY=

AGENT_MEMORY_MAX_MESSAGES=20
AGENT_SUMMARY_EVERY_N=10
AGENT_RAG_MAX_CHUNKS=5

# ---------- 服务 ----------
# 同源反代时浏览器不会触发跨域；这一项是给直连 :3001 调试用的
CORS_ORIGINS=http://YOUR_SERVER_IP,http://localhost:4321
