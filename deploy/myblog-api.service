# 文件说明：Express API 的 systemd 单元（生产环境用，替代 nodemon）。
# 安装：
#   sudo cp deploy/myblog-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now myblog-api
# 查看日志：
#   journalctl -u myblog-api -f

[Unit]
Description=MyBlog API (Astro blog + upload/agent service)
Documentation=https://github.com/MIEBADEBABAJIAMIEJIANGUO/MyBlog
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/myblog
EnvironmentFile=/opt/myblog/.env
Environment=NODE_ENV=production
# 2G 内存机器：把 V8 老生代压到 512MB，剩余留给 mongo/minio
Environment=NODE_OPTIONS=--max-old-space-size=512
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=3
# 崩溃循环保护：5 分钟内重启超过 10 次就停
StartLimitBurst=10
StartLimitIntervalSec=300
LimitNOFILE=65535

# 基础加固
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
