# 上传服务 API 地址（前端可访问，需 PUBLIC_ 前缀）
# 注意：PUBLIC_ 变量在 `astro build` 时就被写进产物，改完必须重新构建才生效。
PUBLIC_UPLOAD_API=http://localhost:3001

# MongoDB（Windows + Docker 建议 127.0.0.1，避免 localhost/IPv6 查库卡住）
MONGODB_URI=mongodb://127.0.0.1:27017/eccentric-event?directConnection=true&serverSelectionTimeoutMS=5000

# MinIO
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=uploads
PUBLIC_FILE_BASE_URL=http://localhost:9000/uploads

# DeepSeek（Agent 对话，必填方可聊天）；此处只写占位符，真实 key 放本地 .env（已被 .gitignore 忽略）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Tavily（Agent 联网搜索，可选）
TAVILY_API_KEY=

# Agent 记忆与 RAG（可选）
AGENT_MEMORY_MAX_MESSAGES=20
AGENT_SUMMARY_EVERY_N=10
AGENT_RAG_MAX_CHUNKS=5
